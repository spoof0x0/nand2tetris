/**
 * Demultiplexor:
 * [a, b] = [in, 0] if sel = 0
 *          [0, in] if sel = 1

   in  sel
   a    0
   b    1

   a = and(in,notsel)
   b = and(in,sel)

 */
 
CHIP DMux {
    IN in, sel;
    OUT a, b;

    PARTS:
    Not(in=sel , out=notSel );
    And(a=in , b=notSel , out=a );
    And(a=in , b=sel , out=b );
}