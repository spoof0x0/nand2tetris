/**
 * Memory of 16K 16-bit registers.
 * If load is asserted, the value of the register selected by
 * address is set to in; Otherwise, the value does not change.
 * The value of the selected register is emitted by out.
 */

CHIP RAM16K {
    IN in[16], load, address[14];
    OUT out[16];

    PARTS:
    DMux4Way(in=load , sel=address[0..1] , a=r1 , b=r2 , c=r3 , d=r4 );
    
    RAM4K(in=in , load=r1 , address=address[2..13] , out=q1 );
    RAM4K(in=in , load=r2 , address=address[2..13] , out=q2 );
    RAM4K(in=in , load=r3 , address=address[2..13] , out=q3 );
    RAM4K(in=in , load=r4 , address=address[2..13] , out=q4 );
    
    Mux4Way16(a=q1 , b=q2 , c=q3 , d=q4 , sel=address[0..1] , out=out );
}